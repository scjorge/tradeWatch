# Copie para .env, ajuste e rode ./scripts/generate-secrets.sh para preencher os segredos no final do arquivo.

# production | development
APP_ENV=production
# URL pública usada nos links de e-mail (sem barra no final)
APP_BASE_URL=http://192.168.2.146:8080
# Outros endereços pelos quais o app é acessado (ex.: http://192.168.0.10:8080), separados por vírgula.
# Acessos pelo mesmo host/porta do pedido já são aceitos automaticamente.
ALLOWED_ORIGINS=
# Em produção com HTTPS deixe true. Para testar em http://localhost no Safari, use false.
COOKIE_SECURE=true
REQUIRE_EMAIL_VERIFICATION=false
LOG_LEVEL=INFO

# Porta/endereço onde o frontend fica acessível
WEB_BIND=127.0.0.1
WEB_PORT=8080

# E-mail: por padrão usa o Mailpit local (http://localhost:8025). Em produção configure seu SMTP.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_STARTTLS=false
SMTP_FROM=TradeWatch <no-reply@tradewatch.local>

# Integrações
BINANCE_BASE_URL=https://api.binance.com
SYNC_INTERVAL_MINUTES=5

# Rotação de chave do cofre: deixe vazio para usar a maior versão de CREDENTIALS_KEYS
CREDENTIALS_ACTIVE_KEY_VERSION=

# Backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14

# Somente para docker-compose.traefik.yml
PUBLIC_HOST=tradewatch.example.com

# ---- Segredos ----------------------------------------------------------------------------------
# Preenchidos por ./scripts/generate-secrets.sh (só gera os que estiverem vazios). Proteja o .env: chmod 600.
# Guarde CREDENTIALS_KEYS e BACKUP_PASSPHRASE também fora do servidor (gerenciador de senhas):
# sem eles não é possível ler as credenciais cifradas nem restaurar os backups.
POSTGRES_PASSWORD=
# Chaves do cofre: "<versão>:<base64 de 32 bytes>", várias separadas por vírgula (ex.: 1:AAA...,2:BBB...)
CREDENTIALS_KEYS=
BACKUP_PASSPHRASE=
SMTP_PASSWORD=
