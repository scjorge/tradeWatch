# Copie para .env e ajuste. NÃO coloque segredos aqui: eles ficam em ./secrets (veja scripts/generate-secrets.sh).

# production | development
APP_ENV=production
# URL pública usada nos links de e-mail (sem barra no final)
APP_BASE_URL=http://localhost:8080
# Outros endereços pelos quais o app é acessado (ex.: http://192.168.0.10:8080), separados por vírgula.
# Acessos pelo mesmo host/porta do pedido já são aceitos automaticamente.
ALLOWED_ORIGINS=
# Em produção com HTTPS deixe true. Para testar em http://localhost no Safari, use false.
COOKIE_SECURE=true
REQUIRE_EMAIL_VERIFICATION=false
LOG_LEVEL=INFO

# Porta/endereço onde o frontend fica acessível
WEB_BIND=127.0.0.1
WEB_PORT=8080

# E-mail: por padrão usa o Mailpit local (http://localhost:8025). Em produção configure seu SMTP.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_STARTTLS=false
SMTP_FROM=TradeWatch <no-reply@tradewatch.local>

# Integrações
BINANCE_BASE_URL=https://api.binance.com
SYNC_INTERVAL_MINUTES=15

# Rotação de chave do cofre: deixe vazio para usar a maior versão do arquivo de chaves
CREDENTIALS_ACTIVE_KEY_VERSION=

# Backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14

# Somente para docker-compose.traefik.yml
PUBLIC_HOST=tradewatch.example.com
