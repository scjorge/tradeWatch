# Produção — copie para .env no servidor. Segredos NÃO vão aqui: ficam em ./secrets (scripts/generate-secrets.sh).

# Imagens publicadas por scripts/build-push.sh
IMAGE_NAMESPACE=seu-usuario-dockerhub
IMAGE_TAG=latest

# Domínio público (HTTPS). Os links dos e-mails usam https://PUBLIC_HOST
PUBLIC_HOST=tradewatch.seudominio.com.br
# Outros endereços aceitos nas requisições, separados por vírgula (normalmente vazio)
ALLOWED_ORIGINS=

# Traefik
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=le
# E-mail para o Let's Encrypt (usado só com --profile traefik)
ACME_EMAIL=voce@seudominio.com.br

# E-mail transacional (confirmação de conta, recuperação de senha). A senha vai em secrets/smtp_password.
SMTP_HOST=smtp.seuprovedor.com
SMTP_PORT=587
SMTP_USER=usuario-smtp
SMTP_STARTTLS=true
SMTP_FROM=TradeWatch <no-reply@seudominio.com.br>
REQUIRE_EMAIL_VERIFICATION=true

LOG_LEVEL=INFO
BINANCE_BASE_URL=https://api.binance.com
SYNC_INTERVAL_MINUTES=15

# Rotação do cofre: vazio = maior versão de secrets/credentials_keys
CREDENTIALS_ACTIVE_KEY_VERSION=

# Backups cifrados
BACKUP_DIR=./backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14
