# Produção — copie para .env no servidor e rode ./scripts/generate-secrets.sh para preencher os segredos.

# Imagens publicadas por scripts/build-push.sh
IMAGE_NAMESPACE=seu-usuario-dockerhub
IMAGE_TAG=latest

# Domínio público (HTTPS). Os links dos e-mails usam https://PUBLIC_HOST
PUBLIC_HOST=tradewatch.seudominio.com.br
# Outros endereços aceitos nas requisições, separados por vírgula (normalmente vazio)
ALLOWED_ORIGINS=

# Traefik
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=le
# E-mail para o Let's Encrypt (usado só com --profile traefik)
ACME_EMAIL=voce@seudominio.com.br

# E-mail transacional (confirmação de conta, recuperação de senha). A senha vai em SMTP_PASSWORD, abaixo.
SMTP_HOST=smtp.seuprovedor.com
SMTP_PORT=587
SMTP_USER=usuario-smtp
SMTP_STARTTLS=true
SMTP_FROM=TradeWatch <no-reply@seudominio.com.br>
REQUIRE_EMAIL_VERIFICATION=true

LOG_LEVEL=INFO
BINANCE_BASE_URL=https://api.binance.com
SYNC_INTERVAL_MINUTES=15

# Rotação do cofre: vazio = maior versão de CREDENTIALS_KEYS
CREDENTIALS_ACTIVE_KEY_VERSION=

# Backups cifrados
BACKUP_DIR=./backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14

# ---- Segredos ----------------------------------------------------------------------------------
# Preenchidos por ./scripts/generate-secrets.sh (só gera os que estiverem vazios). Proteja o .env: chmod 600.
# Guarde CREDENTIALS_KEYS e BACKUP_PASSPHRASE também fora do servidor (gerenciador de senhas):
# sem eles não é possível ler as credenciais cifradas nem restaurar os backups.
POSTGRES_PASSWORD=
# Chaves do cofre: "<versão>:<base64 de 32 bytes>", várias separadas por vírgula (ex.: 1:AAA...,2:BBB...)
CREDENTIALS_KEYS=
BACKUP_PASSPHRASE=
SMTP_PASSWORD=
